data/assets/
data/fonts/
data/ocr/

# ---- frontend ----
web/node_modules/
web/.next/
web/out/
*.tsbuildinfo

# ---- generated test fixtures ----
tests/fixtures/

# ---- release packages ----
dist/

# ---- local env / logs ----
*.log
.env
.env.local

# ---- editor / OS junk ----
.vscode/
.idea/
Thumbs.db
.DS_Store
